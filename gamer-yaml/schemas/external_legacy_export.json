{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "part": {
      "enum": [
        "metadata",
        "snapshot"
      ]
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    }
  },
  "required": [
    "package_id",
    "candidate_id"
  ]
}
