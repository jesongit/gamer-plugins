{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "script_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "from_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "to_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    }
  },
  "required": [
    "package_id",
    "script_id",
    "from_version",
    "to_version"
  ]
}
