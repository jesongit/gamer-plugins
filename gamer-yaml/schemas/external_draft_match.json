{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "script_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "expected_version": {
      "type": "string",
      "maxLength": 40
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sample_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "enum": [
            "gamer-video",
            "gamer-yaml"
          ]
        },
        "sample_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "plugin_id",
        "sample_id",
        "content_sha256"
      ]
    },
    "frame_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "region": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32768
      }
    }
  },
  "required": [
    "package_id",
    "script_id",
    "expected_version",
    "name",
    "sample_ref",
    "frame_id"
  ]
}
