{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recording_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "new_sample_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "start_us": {
      "type": "integer",
      "minimum": 0
    },
    "end_us": {
      "type": "integer",
      "minimum": 0
    },
    "ignored_actions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "event_id",
          "reason"
        ]
      }
    }
  },
  "required": [
    "recording_id",
    "new_sample_id",
    "name",
    "start_us",
    "end_us"
  ]
}
