{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sample_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8388608
    }
  },
  "required": [
    "sample_id",
    "content_sha256",
    "base64"
  ]
}
