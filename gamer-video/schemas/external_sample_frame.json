{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sample_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frame_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "max_width": {
      "type": "integer",
      "minimum": 320,
      "maximum": 1920
    }
  },
  "required": [
    "sample_id",
    "content_sha256",
    "frame_id"
  ]
}
